{
  "name": "volunteer-database",
  "version": "0.1.0",
  "private": true,
  "description": "Esquema de dados do protótipo do Sistema de Voluntários",
  "scripts": {
    "test": "node --test",
    "test:db": "node --env-file-if-exists=.env --test test/database.integration.test.js",
    "test:cache": "node --env-file-if-exists=.env --test test/cache.integration.test.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "types:check": "tsc --project tsconfig.json",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "redis": "^6.2.1"
  }
}
